option "title" "Спільне"
option "operating_currency" "PLN"

2026-07-01 custom "fava-extension" "fava_report"
2026-07-01 custom "fava-extension" "fava_shared"
2026-07-01 custom "fava-option" "language" "uk"
2026-07-01 custom "fava-option" "invert-income-liabilities-equity" "true"
2026-07-01 custom "fava-option" "show-accounts-with-zero-transactions" "false"
2026-07-01 custom "fava-option" "show-accounts-with-zero-balance" "false"

; Спільні витрати (оренда, Kaufland, Auchan, світло, інтернет) ділимо навпіл.
; Income:Заплатив:<імʼя>: скільки кожен вніс за спільне. Fava показує це додатним числом
; (опція invert-income-liabilities-equity), а «Чистий дохід» спільного обліку завжди 0.
2026-07-01 open Income:Заплатив:Оля            PLN
2026-07-01 open Income:Заплатив:Марко          PLN
2026-07-01 open Expenses:Житло                 PLN
2026-07-01 open Expenses:Продукти              PLN
2026-07-01 open Expenses:Звязок                PLN
2026-07-01 open Expenses:Комунальні            PLN

2026-07-01 query "хто-кому-винен" "
  SELECT year, month, account, sum(number) AS paid
  WHERE account ~ '^Income:Заплатив'
  GROUP BY year, month, account
  ORDER BY year, month, account"

include "spilne-transactions.beancount"
